---
import '@fontsource-variable/inter/opsz.css';
import '../styles/global.css';
import interLatin from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';

import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../config/sito.json';
import { dictionary, fill, languages, pathFor, type Lang } from '../i18n';
import { photosOf } from '../lib/photos';
import { lodgingSchema } from '../lib/structured-data';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang);
const values = {
  sconto: site.prenotazione.scontoDirettoPercentuale,
};
const title = t.meta.title;
const description = fill(t.meta.description, values);
const canonical = new URL(pathFor(lang), site.dominio).href;

// Share preview (WhatsApp, Facebook...): the hero photo cut to 1200 × 630.
const heroPhoto = photosOf('hero')[0];
const shareImage = heroPhoto
  ? new URL((await getImage({ src: heroPhoto, width: 1200, height: 630, format: 'jpg', quality: 82 })).src, site.dominio).href
  : undefined;
const schema = JSON.stringify(lodgingSchema({ url: canonical, description, image: shareImage }));
---

<!doctype html>
<html lang={t.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {languages.map((l) => <link rel="alternate" hreflang={l} href={new URL(pathFor(l), site.dominio).href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL('/', site.dominio).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={t.ogLocale} />
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareImage && <meta property="og:image:alt" content={t.hero.photoAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {languages.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={dictionary(l).ogLocale} />)}

    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <script type="application/ld+json" set:html={schema} />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />

    <script is:inline>
      // Prepara l'animazione iniziale solo se JavaScript è attivo e il visitatore non ha chiesto meno movimento.
      (function () {
        var root = document.documentElement;
        root.classList.add('js');
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          root.classList.add('motion');
          setTimeout(function () { root.classList.add('intro-done'); }, 4000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>
    <Header lang={lang} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
