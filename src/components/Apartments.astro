---
import { Picture } from 'astro:assets';
import Missing from './Missing.astro';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import data from '../config/appartamenti.json';
import site from '../config/sito.json';
import { dictionary, fill, type Lang } from '../i18n';
import { photosOf } from '../lib/photos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang);
const a = t.apartments;
const petsAllowed = site.animali.ammessi as Record<string, boolean>;

type BedKey = keyof typeof t.beds;
const bedsText = (beds: { tipo: string; quantita: number }[] | null) =>
  beds
    ?.map(({ tipo, quantita }) => {
      const names = t.beds[tipo as BedKey];
      return `${quantita} ${quantita === 1 ? names.one : names.other}`;
    })
    .join(', ') ?? null;

// Simple line icons for the services, drawn on a 24×24 grid.
const icons: Record<string, string> = {
  parcheggio: '<rect x="4" y="4" width="16" height="16" rx="4"/><path d="M10 16.5v-9h3.2a2.6 2.6 0 0 1 0 5.2H10"/>',
  wifi: '<path d="M3.5 9.6a12 12 0 0 1 17 0M6.6 12.8a7.6 7.6 0 0 1 10.8 0M9.6 15.9a3.3 3.3 0 0 1 4.8 0"/><circle cx="12" cy="18.8" r="1" fill="currentColor" stroke="none"/>',
  aria_condizionata: '<path d="M12 3v18M4.2 7.5l15.6 9M4.2 16.5l15.6-9M9.5 4.5 12 7l2.5-2.5M9.5 19.5 12 17l2.5 2.5"/>',
  tv: '<rect x="3" y="5" width="18" height="12" rx="2.5"/><path d="M9 20.5h6M12 17v3.5"/>',
  riscaldamento: '<path d="M12 3.5c1.2 3-3.2 4.6-3.2 8.2a3.2 3.2 0 0 0 6.4 0c0-1.4-.6-2.3-1.2-3.2-.2 1-.8 1.6-1.6 1.8.6-2.4.4-4.6-.4-6.8Z"/><path d="M7 20.5h10"/>',
  piscina: '<path d="M3 16c2 0 2-1.5 4.5-1.5S10 16 12 16s2-1.5 4.5-1.5S19 16 21 16M3 20c2 0 2-1.5 4.5-1.5S10 20 12 20s2-1.5 4.5-1.5S19 20 21 20"/><path d="M8 12V6.5a2 2 0 0 1 4 0M14 12V6.5a2 2 0 0 1 4 0M8 9h6M8 12h6"/>',
  terrazza: '<path d="M3 10.5h18M5 10.5V20M19 10.5V20M9 10.5V20M15 10.5V20M3 20h18"/><path d="M4 10.5 12 4l8 6.5"/>',
  cucina: '<path d="M4.5 10.5h15v5a4 4 0 0 1-4 4h-7a4 4 0 0 1-4-4v-5ZM2.5 10.5h2M19.5 10.5h2M9.5 7.5c0-1.2 1-1.6 1-3M13.5 7.5c0-1.2 1-1.6 1-3"/>',
  self_checkin:
    '<rect x="5.5" y="3" width="13" height="18" rx="3"/><g fill="currentColor" stroke="none"><circle cx="9.2" cy="8" r="1"/><circle cx="12" cy="8" r="1"/><circle cx="14.8" cy="8" r="1"/><circle cx="9.2" cy="12" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="14.8" cy="12" r="1"/><circle cx="9.2" cy="16" r="1"/><circle cx="12" cy="16" r="1"/><circle cx="14.8" cy="16" r="1"/></g>',
};

const apartments = data.appartamenti.map((apt) => ({
  ...apt,
  photos: photosOf(apt.id),
  type: t.types[apt.tipo as keyof typeof t.types],
  floor: t.floors[apt.piano as keyof typeof t.floors],
  view: t.views[apt.vista as keyof typeof t.views],
  beds: bedsText(apt.letti),
  pets: Boolean(petsAllowed[apt.id]),
}));
---

<section id="apartments" class="section apts" aria-labelledby="apartments-title" data-apartments>
  <div class="container">
    <h2 id="apartments-title" class="section__title" data-reveal>{a.title}</h2>
    <p class="section__intro" data-reveal>{a.intro}</p>

    <div class="apts__tabs" role="tablist" aria-label={a.tabs} data-apt-tabs>
      <span class="apts__indicator" aria-hidden="true" data-apt-indicator></span>
      {
        apartments.map((apt, i) => (
          <button
            type="button"
            class="apts__tab"
            role="tab"
            id={`tab-${apt.id}`}
            aria-controls={`panel-${apt.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
            data-apt-tab={apt.id}
          >
            <span class="apts__tab-name">{apt.nome}</span>
            <span class="apts__tab-meta">{fill(a.sleeps, { n: apt.postiLetto })}</span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="apts__stage" data-apt-stage>
    {
      apartments.map((apt, i) => (
        <div
          class="apt"
          role="tabpanel"
          id={`panel-${apt.id}`}
          aria-labelledby={`tab-${apt.id}`}
          hidden={i !== 0}
          data-apt-panel={apt.id}
        >
          <div class="gallery" data-gallery>
            <div class="gallery__track" role="region" aria-label={fill(a.gallery, { nome: apt.nome })} tabindex="0" data-gallery-track>
              {apt.photos.length
                ? apt.photos.map((photo, n) => (
                    <figure class="gallery__slide" aria-label={fill(a.photoOf, { n: n + 1, total: apt.photos.length })}>
                      <div class="gallery__media" data-reveal-frame>
                        <div class="gallery__parallax">
                          <Picture
                            src={photo}
                            alt=""
                            formats={['avif', 'webp']}
                            widths={[640, 960, 1280, 1600, 2000]}
                            sizes="(min-width: 64rem) 58rem, 86vw"
                            loading="lazy"
                          />
                        </div>
                      </div>
                    </figure>
                  ))
                : [1, 2, 3].map((n) => (
                    <figure class="gallery__slide" aria-label={fill(a.photoOf, { n, total: 3 })}>
                      <div class="gallery__media" data-reveal-frame>
                        <div class="gallery__parallax">
                          <PhotoPlaceholder
                            label={`${apt.nome} ${n}, cartella src/assets/foto/${apt.id}`}
                            tone={apt.vista === 'giardino_privato' ? 'garden' : 'lake'}
                          />
                        </div>
                      </div>
                    </figure>
                  ))}
            </div>

            <div class="gallery__controls container">
              <p class="gallery__count" aria-hidden="true">
                <span data-gallery-index>1</span> / {apt.photos.length || 3}
              </p>
              <div class="gallery__buttons">
                <button type="button" class="gallery__btn" data-gallery-prev aria-label={a.prevPhoto} aria-disabled="true">
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5L5.5 8l4.5 4.5" /></svg>
                </button>
                <button type="button" class="gallery__btn" data-gallery-next aria-label={a.nextPhoto}>
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 3.5L10.5 8 6 12.5" /></svg>
                </button>
              </div>
            </div>
          </div>

          <div class="apt__info container" data-apt-info>
            <div>
              <h3 class="apt__name">{apt.nome}</h3>
              <p class="apt__type">{apt.type}</p>

              <dl class="apt__facts">
                <div>
                  <dt>{a.floor}</dt>
                  <dd>{apt.floor}</dd>
                </div>
                <div>
                  <dt>{a.view}</dt>
                  <dd>{apt.view}</dd>
                </div>
                <div>
                  <dt>{a.sleepsLabel}</dt>
                  <dd>{apt.postiLetto}</dd>
                </div>
                <div>
                  <dt>{a.beds}</dt>
                  <dd>{apt.beds ?? <Missing what={`appartamenti.json → ${apt.id} → letti`} />}</dd>
                </div>
                <div>
                  <dt>{a.size}</dt>
                  <dd>
                    {apt.metraturaMq ? `${apt.metraturaMq} m²` : <Missing what={`appartamenti.json → ${apt.id} → metraturaMq`} />}
                  </dd>
                </div>
                <div>
                  <dt>{a.pets}</dt>
                  <dd class:list={{ 'apt__pets-yes': apt.pets }}>{apt.pets ? a.petsYes : a.petsNo}</dd>
                </div>
              </dl>
            </div>

            <div class="apt__side">
              <h4 class="apt__services-title">
                {a.services} {'_nota_servizi' in data && <Missing what="servizi da confermare (appartamenti.json)" />}
              </h4>
              <ul class="apt__services">
                {apt.servizi.map((service) => (
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true" set:html={icons[service] ?? ''} />
                    <span>{t.services[service as keyof typeof t.services]}</span>
                  </li>
                ))}
              </ul>
              <button type="button" class="btn apt__book" data-apt-book>
                {fill(a.book, { nome: apt.nome })}
              </button>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  /* ---------- Tab ---------- */
  .apts__tabs {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    max-width: 34rem;
    margin-top: clamp(2rem, 5vw, 3.25rem);
    padding: 0.3125rem;
    border-radius: var(--r-lg);
    background: var(--calcare);
  }

  .apts__indicator {
    position: absolute;
    top: 0.3125rem;
    bottom: 0.3125rem;
    left: 0.3125rem;
    width: calc((100% - 0.625rem) / 3);
    border-radius: calc(var(--r-lg) - 0.3125rem);
    background: var(--calce);
    box-shadow: var(--shadow-1);
  }

  .apts__tab {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.125rem;
    min-height: 3.75rem;
    padding: 0.625rem 0.5rem;
    border-radius: calc(var(--r-lg) - 0.3125rem);
    color: var(--pietra);
    transition: color var(--dur-base) var(--ease-out);
  }

  .apts__tab:hover,
  .apts__tab[aria-selected='true'] {
    color: var(--lago);
  }

  .apts__tab-name {
    font-family: var(--font-display);
    font-size: var(--t-18);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .apts__tab-meta {
    font-size: var(--t-12);
    font-weight: 500;
  }

  /* ---------- Galleria ---------- */
  .apts__stage {
    margin-top: clamp(1.75rem, 4vw, 2.5rem);
  }

  .gallery__track {
    --edge: max(var(--gutter), calc((100% - var(--max)) / 2));
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.25rem);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    padding-inline: var(--edge);
    scrollbar-width: none;
  }

  .gallery__track::-webkit-scrollbar {
    display: none;
  }

  .gallery__track:focus-visible {
    outline-offset: -2px;
  }

  .gallery__slide {
    flex: 0 0 86%;
    margin: 0;
    scroll-snap-align: start;
  }

  .gallery__media {
    /* The photo layer starts 6% above the frame (6 / 112 of its height) */
    --placeholder-label-top: calc(1rem + 5.4%);
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    overflow: clip;
    border-radius: var(--r-lg);
    background: var(--calcare);
  }

  /* Un po' più alta della cornice, per il parallax leggero */
  .gallery__parallax {
    position: absolute;
    inset: -6% 0;
  }

  .gallery__parallax picture,
  .gallery__parallax img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 1rem;
  }

  .gallery__count {
    color: var(--pietra);
    font-size: var(--t-14);
    font-variant-numeric: tabular-nums;
  }

  .gallery__buttons {
    display: flex;
    gap: 0.5rem;
  }

  .gallery__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgb(12 46 54 / 0.2);
    transition:
      box-shadow var(--dur-fast) var(--ease-out),
      opacity var(--dur-fast) var(--ease-out),
      transform var(--dur-fast) var(--ease-out);
  }

  .gallery__btn svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gallery__btn:hover:not([aria-disabled='true']) {
    box-shadow: inset 0 0 0 1px rgb(12 46 54 / 0.5);
  }

  .gallery__btn:active:not([aria-disabled='true']) {
    transform: scale(0.94);
  }

  /* aria-disabled, not disabled: the button keeps keyboard focus at the first or last photo */
  .gallery__btn[aria-disabled='true'] {
    opacity: 0.3;
    cursor: default;
  }

  /* ---------- Dettagli ---------- */
  .apt__info {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .apt__name {
    font-size: clamp(var(--t-48), 6vw, var(--t-72));
    line-height: 1;
  }

  .apt__type {
    margin-top: 0.5rem;
    color: var(--pietra);
    font-size: var(--t-21);
  }

  .apt__facts {
    margin-top: 1.75rem;
  }

  .apt__facts > div {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 1rem;
    padding-block: 0.875rem;
    border-top: 1px solid var(--linea);
  }

  .apt__facts > div:last-child {
    border-bottom: 1px solid var(--linea);
  }

  .apt__facts dt {
    color: var(--pietra);
  }

  .apt__facts dd {
    margin: 0;
    font-weight: 500;
  }

  .apt__pets-yes {
    color: var(--ulivo);
  }

  .apt__services-title {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1rem;
    color: var(--pietra);
    font-family: var(--font-text);
    font-size: var(--t-14);
    font-weight: 600;
    letter-spacing: 0;
  }

  .apt__services {
    display: grid;
    gap: 0.875rem;
    padding: 0;
    list-style: none;
  }

  .apt__services li {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }

  .apt__services svg {
    flex: none;
    width: 1.5rem;
    height: 1.5rem;
    fill: none;
    stroke: var(--ulivo);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .apt__book {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .gallery__slide {
      flex-basis: min(78%, 58rem);
    }

    .gallery__media {
      aspect-ratio: 16 / 10;
    }
  }

  @media (min-width: 56rem) {
    .apt__info {
      grid-template-columns: 1.3fr 1fr;
      gap: clamp(3rem, 7vw, 6rem);
    }

    .apt__side {
      padding-top: 0.75rem;
    }

    .apt__facts > div {
      grid-template-columns: 11rem 1fr;
    }
  }
</style>
