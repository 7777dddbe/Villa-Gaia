---
import { Picture } from 'astro:assets';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { dictionary, fill, type Lang } from '../i18n';
import { photosOf } from '../lib/photos';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const v = dictionary(lang).villa;
const photos = photosOf('villa');
---

<section id="villa" class="section villa" aria-labelledby="villa-title">
  <div class="container">
    <p class="villa__eyebrow" data-reveal>{v.eyebrow}</p>
    <h2 id="villa-title" class="section__title" data-reveal>{v.title}</h2>

    <div class="villa__intro">
      <p class="section__intro" data-reveal>{v.text}</p>
      <ul class="villa__features" data-reveal>
        {v.features.map((feature) => <li>{feature}</li>)}
      </ul>
    </div>

    <ul class="villa__grid" aria-label={v.galleryLabel}>
      {
        photos.length > 0 ? (
          photos.map((photo, i) => (
            <li class:list={['villa__item', { 'villa__item--wide': i === 0 }]} data-reveal-frame>
              <Picture
                src={photo}
                alt={fill(v.alt, { n: i + 1, total: photos.length })}
                formats={['avif', 'webp']}
                widths={[480, 800, 1200, 1600]}
                sizes={i === 0 ? '(min-width: 56rem) 66vw, 100vw' : '(min-width: 56rem) 33vw, 50vw'}
                loading="lazy"
              />
            </li>
          ))
        ) : (
          <li class="villa__item villa__item--wide">
            <PhotoPlaceholder label="la villa (cartella src/assets/foto/villa)" tone="garden" />
          </li>
        )
      }
    </ul>
  </div>
</section>

<style is:global>
  .villa__eyebrow {
    margin-bottom: 1rem;
    color: var(--garda);
    font-size: var(--t-14);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .villa__intro {
    display: grid;
    gap: 2rem;
    margin-top: 0.5rem;
  }

  .villa__features {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    list-style: none;
    padding: 0;
    font-size: var(--t-18);
  }

  .villa__features li {
    position: relative;
    padding-left: 1.75rem;
  }

  .villa__features li::before {
    content: '';
    position: absolute;
    top: 0.55em;
    left: 0;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 50%;
    background: var(--ulivo);
  }

  .villa__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 6vw, 4rem);
    padding: 0;
    list-style: none;
  }

  .villa__item {
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--calcare);
    aspect-ratio: 4 / 3;
  }

  .villa__item--wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  /* An odd photo left over on a phone fills the whole last row. */
  .villa__item:last-child:nth-child(even) {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .villa__item picture,
  .villa__item img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .villa__item img {
    object-fit: cover;
    transition: transform 0.8s var(--ease-out);
  }

  @media (hover: hover) {
    .villa__item:hover img {
      transform: scale(1.03);
    }
  }

  @media (min-width: 48rem) {
    .villa__intro {
      grid-template-columns: 1.4fr 1fr;
      gap: 4rem;
      align-items: start;
    }

    /* The first photo covers 2 × 2 cells, the others fill the rest: 12 photos = 4 full rows of 3. */
    .villa__grid {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: clamp(11rem, 19vw, 17rem);
      gap: 0.75rem;
    }

    .villa__item,
    .villa__item--wide,
    .villa__item:last-child:nth-child(even) {
      grid-column: auto;
      aspect-ratio: auto;
    }

    .villa__item--wide {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
</style>
