---
import { Picture } from 'astro:assets';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { photosOf } from '../lib/photos';
import { dictionary, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = dictionary(lang);

// La prima foto in src/assets/foto/hero/ diventa la foto principale.
// In hero-primo-piano/ c'è la stessa foto senza cielo (scripts/ritaglia-cielo.mjs):
// messa sopra il titolo, fa passare la scritta dietro le montagne.
const photo = photosOf('hero')[0];
const foreground = photo ? photosOf('hero-primo-piano')[0] : undefined;
// Same sizes for both layers, so they always line up.
const formats: ('avif' | 'webp')[] = ['avif', 'webp'];
const widths = [640, 960, 1280, 1920, 2400];

const subtitle = t.hero.subtitle;
---

<section class:list={['hero', { 'hero--depth': foreground }]} data-hero aria-labelledby="hero-title">
  <!-- 1. Fondo: la foto intera -->
  <div class="hero__media">
    <div class="hero__parallax" data-hero-parallax>
      <div class="hero__photo" data-hero-photo>
        {
          photo ? (
            <Picture src={photo} alt={t.hero.photoAlt} formats={formats} widths={widths} sizes="100vw" loading="eager" fetchpriority="high" />
          ) : (
            <PhotoPlaceholder label="vista lago dalla terrazza" />
          )
        }
      </div>
    </div>
    <div class="hero__sky" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <!-- 2. In mezzo: il titolo -->
    <h1 id="hero-title" class="hero__title" data-intro data-hero-title>
      <span class="hero__mask"><span class="hero__line" data-hero-line>{t.hero.line1}</span></span>{' '}
      <span class="hero__mask"><span class="hero__line hero__line--place" data-hero-line>{t.hero.line2}</span></span>
      <span class="visually-hidden">{t.hero.titleSuffix}</span>
    </h1>

    <!-- 4. Davanti a tutto: testo e ricerca -->
    <p class="hero__subtitle" data-intro data-hero-sub>{subtitle}</p>
    <slot />
  </div>

  <!-- Wink: a hint about the photo, desktop only -->
  <div class="wink" data-wink>
    <button type="button" class="wink__button" aria-expanded="false" aria-controls="wink-text" aria-label={t.hero.winkLabel} data-wink-button>
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <g class="wink__eye">
          <path d="M6 24Q24 6 42 24Q24 42 6 24Z" fill="#fff" stroke="#0c2e36" stroke-width="2.6" stroke-linejoin="round" />
          <circle cx="24" cy="24" r="7.6" fill="#0e6a73" />
          <circle cx="24" cy="24" r="3.6" fill="#061a1f" />
          <circle cx="26.6" cy="21.2" r="1.7" fill="#fff" />
        </g>
        <g class="wink__lid" fill="none" stroke="#0c2e36" stroke-width="2.6" stroke-linecap="round">
          <path d="M6 24Q24 36 42 24" />
          <path d="M14 29.5L11.5 33M24 32.5V36.5M34 29.5L36.5 33" stroke-width="2.2" />
        </g>
      </svg>
    </button>
    <p class="wink__bubble" id="wink-text" role="status">{t.hero.winkText}</p>
  </div>

  <!-- 3. Sopra il titolo: montagne, paese e terrazza, senza cielo -->
  {
    foreground && (
      <div class="hero__media hero__media--front" aria-hidden="true">
        <div class="hero__parallax" data-hero-parallax>
          <div class="hero__photo" data-hero-photo>
            <Picture src={foreground} alt="" formats={formats} fallbackFormat="webp" widths={widths} sizes="100vw" loading="eager" />
          </div>
        </div>
        <div class="hero__shade"></div>
      </div>
    )
  }
</section>

<style>
  .hero {
    /* The photo layer is 8% taller at the top for the parallax (8 / 116 of its height). */
    --placeholder-label-top: calc(var(--header-h) + 1rem + 6.9%);
    position: relative;
    display: grid;
    min-height: 100vh;
    min-height: 100svh;
    /* No overflow: hidden here. It would make the hero a scroll box, and focusing the
       search fields or the calendar would scroll its content out of place. */
    /* The terrace photo has a bright sky behind the title: dark ink reads better than white there.
       With a darker hero photo, switch --hero-ink to var(--calce) in tokens.css. */
    color: var(--hero-ink);
    isolation: isolate;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    overflow: clip;
    background: var(--lago);
  }

  .hero__media--front {
    z-index: 2;
    background: none;
    pointer-events: none;
  }

  /* Più alta del contenitore, così il parallax non scopre mai i bordi */
  .hero__parallax {
    position: absolute;
    inset: -8% 0 -8% 0;
  }

  .hero__photo,
  .hero__photo :global(picture),
  .hero__photo :global(img) {
    width: 100%;
    height: 100%;
  }

  /* Both layers must crop exactly the same way, or the mountains would not line up */
  .hero__photo :global(img) {
    object-fit: cover;
    object-position: 54% 30%;
  }

  /* A light veil on the sky behind the title */
  .hero__sky {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgb(255 255 255 / 0.45) 0%, rgb(255 255 255 / 0.12) 32%, rgb(255 255 255 / 0) 50%);
    pointer-events: none;
  }

  /* Darker terrace under the subtitle and the search box, in front of the mountains layer */
  .hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 26 31 / 0.7) 0%, rgb(6 26 31 / 0.4) 24%, rgb(6 26 31 / 0) 46%);
  }

  .hero:not(.hero--depth) .hero__media:not(.hero__media--front)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(6 26 31 / 0.7) 0%, rgb(6 26 31 / 0.4) 24%, rgb(6 26 31 / 0) 46%);
  }

  /* Title and subtitle up on the sky, search box down on the terrace */
  .hero__content {
    display: flex;
    flex-direction: column;
    padding-top: calc(var(--header-h) + clamp(1rem, 3.5vh, 2.5rem));
    /* Room under the search box for its one-line note */
    padding-bottom: clamp(3.75rem, 7vw, 5.5rem);
  }

  /* Layer 2: between the sky and the mountains */
  .hero__title {
    position: relative;
    z-index: 1;
    font-size: clamp(3.5rem, 13.5vw, 11.5rem);
    font-weight: 700;
    line-height: 0.88;
    letter-spacing: -0.055em;
    /* the place name reads a touch lighter, as if a little further away */
    color: var(--hero-ink);
  }

  .hero__line--place {
    color: color-mix(in srgb, var(--hero-ink) 82%, var(--garda));
  }

  /* Maschera per far salire ogni riga del titolo; spazio extra per le discendenti */
  .hero__mask {
    display: block;
    overflow: hidden;
    padding-block: 0.04em 0.14em;
    margin-block: -0.04em -0.14em;
  }

  .hero__line {
    display: block;
    will-change: transform;
  }

  /* Layer 4: in front of everything */
  .hero__subtitle,
  .hero__content > :global(.booking) {
    position: relative;
    z-index: 3;
  }

  .hero__subtitle {
    max-width: 34ch;
    margin-top: auto;
    padding-top: clamp(6rem, 22vh, 14rem);
    color: var(--calce);
    font-size: clamp(var(--t-18), 1.6vw + 0.6rem, var(--t-24));
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-shadow: 0 1px 12px rgb(6 26 31 / 0.35);
  }

  .hero__content > :global(.booking) {
    margin-top: clamp(1rem, 2.5vw, 1.5rem);
  }

  /* ---------- Wink (desktop only) ---------- */
  .wink {
    display: none;
  }

  @media (min-width: 48rem) {
    .wink {
      position: absolute;
      left: clamp(1rem, 2vw, 2rem);
      bottom: 1rem;
      z-index: 4;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
  }

  .wink__button {
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.94);
    box-shadow: 0 6px 18px rgb(6 26 31 / 0.35);
    transition: transform var(--dur-base) var(--ease-out);
  }

  .wink__button:hover {
    transform: scale(1.1);
  }

  .wink__button:active {
    transform: scale(0.95);
  }

  .wink__button svg {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0.4rem;
  }

  /* The eye closes and opens twice, then rests */
  .wink__eye {
    transform-box: fill-box;
    transform-origin: center;
    animation: wink-eye 4.2s ease-in-out infinite;
  }

  .wink__lid {
    opacity: 0;
    animation: wink-lid 4.2s ease-in-out infinite;
  }

  @keyframes wink-eye {
    0%,
    78%,
    86%,
    94%,
    100% {
      transform: scaleY(1);
    }
    82%,
    90% {
      transform: scaleY(0.04);
    }
  }

  @keyframes wink-lid {
    0%,
    79%,
    85%,
    87%,
    93%,
    100% {
      opacity: 0;
    }
    81%,
    83%,
    89%,
    91% {
      opacity: 1;
    }
  }

  .wink__bubble {
    position: relative;
    max-width: 17rem;
    padding: 0.75rem 1.125rem;
    border-radius: var(--r-md);
    background: rgb(255 255 255 / 0.96);
    color: var(--lago);
    font-size: var(--t-14);
    font-weight: 500;
    line-height: 1.4;
    box-shadow: var(--shadow-2);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-8px);
    transition:
      opacity var(--dur-base) var(--ease-out),
      transform var(--dur-base) var(--ease-out),
      visibility 0s var(--dur-base);
  }

  .wink__bubble::before {
    content: '';
    position: absolute;
    left: -0.3rem;
    top: 50%;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: 2px;
    background: inherit;
    transform: translateY(-50%) rotate(45deg);
  }

  .wink[data-open] .wink__bubble {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  @media (prefers-reduced-motion: reduce) {
    .wink__eye,
    .wink__lid {
      animation: none;
    }
  }

  /* Phones: the tall crop puts the mountains lower, so the title comes down to meet them */
  @media (max-width: 47.99rem) {
    .hero--depth .hero__title {
      margin-top: clamp(4rem, 19svh, 11rem);
    }

    .hero__subtitle {
      padding-top: 2rem;
    }
  }
</style>
