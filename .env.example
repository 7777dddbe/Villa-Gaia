# Copia questo file in .env per provare i calendari veri sul tuo computer.
# Su Netlify le stesse variabili vanno in: Site configuration → Environment variables.
# Non mettere mai il file .env su GitHub (è già escluso da .gitignore).
# Tutte sono facoltative: senza nessuna, il sito usa le prenotazioni finte di netlify/dati-prova.json.

# Google Calendar (vedi GUIDA-PUBBLICAZIONE.md, punto 4)
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Booking.com: il link "Esporta calendario" (.ics) di ogni appartamento
# (vedi GUIDA-PUBBLICAZIONE.md, "Prenotazioni da Booking.com"). Lascia vuoto chi non è su Booking.
ICAL_GAIA1=
ICAL_GAIA2=
ICAL_GAIA3=
